# ==============================================================================
# Vacatina Production Environment Configuration Manifest (Names-Only Contract)
# Authority: docs/11_PRODUCTION_IMPLEMENTATION_CHARTER.md & ADR-001
# Note: Never commit real secret values to version control.
# ==============================================================================

# 1. Application Runtime
NODE_ENV=production
PORT=3000
BASE_URL=https://vacatina-nu.vercel.app
APP_VERSION=1.0.0

# 2. Database & Persistence (PostgreSQL / Neon)
DATABASE_URL=postgresql://user:password@host:5432/vacatina_production?sslmode=require
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# 3. Authentication & Tenant Context (Clerk / IdP)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_placeholder
CLERK_PUBLISHABLE_KEY=pk_test_placeholder
CLERK_SECRET_KEY=sk_test_placeholder
CLERK_FRONTEND_API=https://your-app.clerk.accounts.dev
CLERK_JWKS_URL=https://your-app.clerk.accounts.dev/.well-known/jwks.json
CLERK_WEBHOOK_SECRET=whsec_placeholder
JWT_SIGNING_SECRET=placeholder_jwt_secret_for_internal_service_tokens

# 4. Private Document Storage (Cloudflare R2 / S3-Compatible)
R2_ACCOUNT_ID=placeholder_r2_account_id
R2_ACCESS_KEY_ID=placeholder_r2_access_key
R2_SECRET_ACCESS_KEY=placeholder_r2_secret_key
R2_BUCKET_NAME=vacatina-documents-private
R2_PRESIGNED_URL_TTL_SECONDS=900

# 5. Payment Gateways & Webhook Secrets
PAYMENT_GATEWAY_DEFAULT=STRIPE
STRIPE_PUBLISHABLE_KEY=pk_test_placeholder
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder
PAYPAL_CLIENT_ID=placeholder_paypal_client_id
PAYPAL_CLIENT_SECRET=placeholder_paypal_client_secret
PAYPAL_WEBHOOK_ID=placeholder_paypal_webhook_id

# 6. Supplier GDS/NDC & Aggregator APIs (Sandbox vs Production Isolation)
DUFFEL_ENV=test
DUFFEL_API_TOKEN=duffel_test_placeholder
AMADEUS_ENV=test
AMADEUS_CLIENT_ID=amadeus_client_id_placeholder
AMADEUS_CLIENT_SECRET=amadeus_client_secret_placeholder
LITEAPI_ENV=sandbox
LITEAPI_API_KEY=liteapi_test_placeholder
VIATOR_ENV=sandbox
VIATOR_API_KEY=viator_test_placeholder
TRAINLINE_ENV=sandbox
TRAINLINE_API_KEY=trainline_test_placeholder
TRAVELTEK_ENV=sandbox
TRAVELTEK_API_KEY=traveltek_test_placeholder
ALLIANZ_ENV=sandbox
ALLIANZ_API_KEY=allianz_test_placeholder

# 7. Background Outbox & Job Queue
JOB_CONCURRENCY=5
JOB_POLL_INTERVAL_MS=3000
MAX_JOB_RETRIES=5

# 8. Observability & Telemetry (OpenTelemetry)
LOG_LEVEL=info
OTEL_SERVICE_NAME=vacatina-travel-os
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# 9. Transactional Notifications & Operations
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_USER=postmaster@vacatina.com
SMTP_PASS=placeholder_smtp_password
OPERATIONS_TRIAGE_EMAIL=ops@vacatina.com
FINANCE_ALERT_EMAIL=finance@vacatina.com

# 10. AI & Studio Assets (Existing Tools)
OPENAI_API_KEY=placeholder_openai_key
OPENAI_IMAGE_MODEL=gpt-image-2.5-sunburst
