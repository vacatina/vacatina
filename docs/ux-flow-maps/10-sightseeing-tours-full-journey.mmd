graph TD
    S_HUB[/"Sightseeing Tours Hub<br/>/sightseeing-tours"\] --> S_DEST[Destination]
    S_HUB --> S_DATE[Date]
    S_HUB --> S_TYPE[Tour Type]
    S_HUB --> S_SEARCH_BTN[Search Submit]

    S_SEARCH_BTN --> S_VALIDATION{Validation}
    S_VALIDATION -->|Valid| S_SEARCH[Sightseeing Search<br/>/sightseeing-tours/search]
    S_VALIDATION -->|Invalid| S_ERROR[Validation Error]

    S_SEARCH --> S_RESULTS[Sightseeing Results]
    S_RESULTS --> S_OFFER[Sightseeing Offer<br/>/sightseeing-tours/offer/:id]
